{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Event description or notes"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "description": "Event start time in ISO format"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "description": "Event end time in ISO format"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "duration_minutes": {
      "type": "number",
      "default": 30,
      "description": "Duration in minutes"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "completed",
        "cancelled",
        "needs_followup"
      ],
      "default": "scheduled"
    },
    "priority": {
      "type": "string",
      "enum": [
        "P1",
        "P2",
        "P3",
        "P4"
      ],
      "default": "P3",
      "description": "Gmail/Slack-style priority (P1 urgent -> P4 low)"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "gmail",
        "google_calendar"
      ],
      "default": "manual"
    },
    "source_email_id": {
      "type": "string",
      "description": "Reference to the primary source email if created from Gmail"
    },
    "linked_emails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email_id": {
            "type": "string",
            "description": "The linked Email entity id"
          },
          "subject": {
            "type": "string"
          },
          "sender": {
            "type": "string"
          },
          "sender_email": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "gmail_id": {
            "type": "string"
          },
          "source_account": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "mimeType": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                },
                "attachmentId": {
                  "type": "string"
                }
              }
            },
            "default": [],
            "description": "Gmail attachment references carried with this linked email"
          }
        }
      },
      "default": [],
      "description": "Emails included within this item (with their attachment references)"
    },
    "gcal_event_id": {
      "type": "string",
      "description": "Google Calendar event ID for sync"
    },
    "calendar_name": {
      "type": "string",
      "description": "Name of the Google Calendar this event belongs to"
    },
    "is_shared_calendar": {
      "type": "boolean",
      "default": false,
      "description": "True if the event is from a calendar shared with (not owned by) the user"
    },
    "source_account": {
      "type": "string",
      "description": "The account (email) this event was synced from"
    },
    "kanban_column": {
      "type": "string",
      "enum": [
        "todo",
        "doing",
        "done",
        "past"
      ],
      "default": "doing"
    },
    "color": {
      "type": "string",
      "enum": [
        "blue",
        "green",
        "purple",
        "orange",
        "pink"
      ],
      "default": "blue"
    },
    "followup_note": {
      "type": "string",
      "description": "Follow-up note if needs follow-up"
    },
    "flexible": {
      "type": "boolean",
      "default": false,
      "description": "True for to-do items the user can reshuffle (manual/email). Fixed meetings (synced from Google Calendar) stay false and are never moved by squeeze."
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Display names of people invited to this meeting (synced from Google Calendar)"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_url": {
            "type": "string",
            "description": "URL of the attached file"
          },
          "title": {
            "type": "string",
            "description": "Display name of the attached file"
          }
        }
      },
      "default": [],
      "description": "Files attached to this event; mirrored to Google Calendar as event attachments"
    }
  },
  "required": [
    "title",
    "start_time",
    "end_time",
    "date"
  ]
}