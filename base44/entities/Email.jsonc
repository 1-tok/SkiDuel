{
  "name": "Email",
  "type": "object",
  "properties": {
    "sender": {
      "type": "string",
      "description": "Sender name"
    },
    "sender_email": {
      "type": "string",
      "description": "Sender email address"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "preview": {
      "type": "string",
      "description": "First line preview of the email body"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the email was received"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "is_actioned": {
      "type": "boolean",
      "default": false
    },
    "gmail_id": {
      "type": "string",
      "description": "Gmail message ID for sync"
    },
    "source_account": {
      "type": "string",
      "description": "The account this message was synced from"
    },
    "channel": {
      "type": "string",
      "enum": [
        "gmail",
        "whatsapp",
        "sms",
        "linkedin"
      ],
      "default": "gmail",
      "description": "Which channel this message came through"
    },
    "external_id": {
      "type": "string",
      "description": "External message id (Twilio SID, etc.) for dedupe across channels"
    },
    "body": {
      "type": "string",
      "description": "Full message body (for non-Gmail channels)"
    }
  },
  "required": [
    "sender",
    "subject"
  ]
}